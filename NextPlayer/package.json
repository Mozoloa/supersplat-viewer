{
  "name": "@ems/spatial-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "serve": "node server.cjs",
    "develop": "concurrently --kill-others \"npm run watch\" \"npm run serve\"",
    "type:check": "tsc --noEmit",
    "watch": "rollup -c -w"
  },
  "dependencies": {
    "@playcanvas/web-components": "0.10.0",
    "mp4box": "2.4.1",
    "playcanvas": "2.21.3"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.0",
    "@types/webxr": "0.5.24",
    "concurrently": "9.2.4",
    "rollup": "4.62.4",
    "rollup-plugin-copy": "3.5.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
